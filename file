CREATE OR REPLACE FUNCTION public.pg_encerrar_ciclo(p_grupo_id uuid, p_simular boolean DEFAULT true)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE r RECORD; s jsonb; itens jsonb := '[]'::jsonb; total numeric := 0;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM public.pg_grupos WHERE id = p_grupo_id
     AND (user_id = auth.uid() OR public.has_role(auth.uid(),'superadmin'))) THEN
    RETURN jsonb_build_object('error','forbidden');
  END IF;

  PERFORM public.pg_processar_rendimentos(p_grupo_id);

  FOR r IN SELECT id, nome FROM public.pg_membros WHERE grupo_id = p_grupo_id ORDER BY nome LOOP
    s := public.pg_saldo_membro(r.id);
    total := total + (s->>'liquido')::numeric;
    itens := itens || jsonb_build_object(
      'membro_id', r.id, 'nome', r.nome,
      'saldo', (s->>'saldo')::numeric,
      'divida', (s->>'divida')::numeric,
      'liquido', (s->>'liquido')::numeric,
      'devedor', ((s->>'liquido')::numeric < 0)
    );
  END LOOP;

  IF p_simular = false THEN
    UPDATE public.pg_grupos SET estado = 'Encerrado' WHERE id = p_grupo_id;
  END IF;

  RETURN jsonb_build_object('total_liquido', round(total,2), 'itens', itens, 'encerrado', NOT p_simular);
END; $function$
;

CREATE OR REPLACE FUNCTION public.pg_mora_emprestimo(p_emprestimo_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  e RECORD; saldo numeric; dias int; mora numeric := 0; multa numeric := 0;
BEGIN
  SELECT * INTO e FROM public.pg_emprestimos WHERE id = p_emprestimo_id;
  IF NOT FOUND THEN RETURN jsonb_build_object('error','not_found'); END IF;
  saldo := GREATEST(COALESCE(e.valor_total,0) - COALESCE(e.valor_pago,0), 0);
  dias := GREATEST((CURRENT_DATE - e.data_vencimento) - COALESCE(e.dias_tolerancia,0), 0);
  IF saldo > 0 AND dias > 0 THEN
    mora := saldo * (COALESCE(e.taxa_mora_diaria,0)/100.0) * dias;
    IF e.multa_tipo = 'percentagem' THEN multa := saldo * (COALESCE(e.multa_valor,0)/100.0);
    ELSE multa := COALESCE(e.multa_valor,0); END IF;
  END IF;
  RETURN jsonb_build_object(
    'saldo_devedor', round(saldo,2),
    'dias_atraso', dias,
    'mora_total', round(mora,2),
    'mora_pendente', round(GREATEST(mora - COALESCE(e.mora_paga,0),0),2),
    'multa_total', round(multa,2),
    'multa_pendente', round(GREATEST(multa - COALESCE(e.multa_paga,0),0),2),
    'total_devido', round(saldo + GREATEST(mora - COALESCE(e.mora_paga,0),0) + GREATEST(multa - COALESCE(e.multa_paga,0),0),2)
  );
END; $function$
;

CREATE OR REPLACE FUNCTION public.pg_processar_rendimentos(p_grupo_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE d RECORD; n int := 0; total numeric := 0; v numeric;
BEGIN
  FOR d IN
    SELECT dp.* FROM public.pg_depositos dp
    JOIN public.pg_grupos g ON g.id = dp.grupo_id
    WHERE dp.estado = 'activo'
      AND dp.rendimento_creditado = false
      AND dp.data_vencimento <= CURRENT_DATE
      AND g.permitir_rendimento = true
      AND g.estado = 'Ativo'
      AND dp.taxa_rendimento > 0
      AND (p_grupo_id IS NULL OR dp.grupo_id = p_grupo_id)
      AND (dp.user_id = auth.uid() OR public.has_role(auth.uid(),'superadmin'))
  LOOP
    v := round(d.valor * (d.taxa_rendimento/100.0), 2);
    IF v > 0 THEN
      INSERT INTO public.pg_movimentos (user_id, grupo_id, membro_id, tipo, valor, afeta_saldo, descricao, data, referencia_id)
      VALUES (d.user_id, d.grupo_id, d.membro_id, 'rendimento', v, true,
        'Rendimento de ' || d.taxa_rendimento || '% sobre depósito de ' || to_char(d.data_deposito,'DD/MM/YYYY'),
        d.data_vencimento, d.id);
      UPDATE public.pg_depositos
        SET rendimento_creditado = true, rendimento_valor = v, estado = 'liquidado'
        WHERE id = d.id;
      n := n + 1; total := total + v;
    END IF;
  END LOOP;
  RETURN jsonb_build_object('processados', n, 'total_rendimento', round(total,2));
END; $function$
;

CREATE OR REPLACE FUNCTION public.pg_registar_pagamento(p_emprestimo_id uuid, p_valor numeric, p_tipo text, p_data date DEFAULT CURRENT_DATE, p_metodo text DEFAULT NULL::text, p_obs text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE e RECORD; novo_pago numeric;
BEGIN
  SELECT * INTO e FROM public.pg_emprestimos WHERE id = p_emprestimo_id
    AND (user_id = auth.uid() OR public.has_role(auth.uid(),'superadmin')) FOR UPDATE;
  IF NOT FOUND THEN RETURN jsonb_build_object('success',false,'error','Empréstimo não encontrado'); END IF;
  IF p_valor <= 0 THEN RETURN jsonb_build_object('success',false,'error','Valor inválido'); END IF;

  INSERT INTO public.pg_pagamentos (user_id, grupo_id, membro_id, emprestimo_id, valor, tipo, data_pagamento, metodo, observacoes)
  VALUES (e.user_id, e.grupo_id, e.membro_id, e.id, p_valor, p_tipo, p_data, p_metodo, p_obs);

  INSERT INTO public.pg_movimentos (user_id, grupo_id, membro_id, tipo, valor, afeta_saldo, descricao, data, referencia_id)
  VALUES (e.user_id, e.grupo_id, e.membro_id,
    CASE WHEN p_tipo='mora' THEN 'mora' WHEN p_tipo='multa' THEN 'multa' WHEN p_tipo='juros' THEN 'juros' ELSE 'pagamento' END,
    p_valor, false,
    'Pagamento (' || p_tipo || ') do empréstimo de ' || to_char(e.data_desembolso,'DD/MM/YYYY'),
    p_data, e.id);

  IF p_tipo = 'mora' THEN
    UPDATE public.pg_emprestimos SET mora_paga = COALESCE(mora_paga,0) + p_valor WHERE id = e.id;
  ELSIF p_tipo = 'multa' THEN
    UPDATE public.pg_emprestimos SET multa_paga = COALESCE(multa_paga,0) + p_valor WHERE id = e.id;
  ELSE
    novo_pago := COALESCE(e.valor_pago,0) + p_valor;
    UPDATE public.pg_emprestimos
      SET valor_pago = novo_pago,
          estado = CASE WHEN novo_pago >= COALESCE(valor_total,0) THEN 'pago'
                        WHEN CURRENT_DATE > data_vencimento + COALESCE(dias_tolerancia,0) THEN 'vencido'
                        ELSE 'activo' END
      WHERE id = e.id;
  END IF;

  RETURN jsonb_build_object('success', true);
END; $function$
;

CREATE OR REPLACE FUNCTION public.pg_saldo_membro(p_membro_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  capital numeric; rend numeric; lev numeric; saldo numeric;
  divida numeric := 0; m jsonb; r RECORD;
BEGIN
  SELECT COALESCE(SUM(valor),0) INTO capital FROM public.pg_movimentos
    WHERE membro_id = p_membro_id AND tipo = 'deposito' AND estornado = false;
  SELECT COALESCE(SUM(valor),0) INTO rend FROM public.pg_movimentos
    WHERE membro_id = p_membro_id AND tipo = 'rendimento' AND estornado = false;
  SELECT COALESCE(SUM(valor),0) INTO lev FROM public.pg_movimentos
    WHERE membro_id = p_membro_id AND tipo = 'levantamento' AND estornado = false;
  saldo := capital + rend - lev;

  FOR r IN SELECT id FROM public.pg_emprestimos
    WHERE membro_id = p_membro_id AND estado NOT IN ('pago','cancelado')
  LOOP
    m := public.pg_mora_emprestimo(r.id);
    divida := divida + COALESCE((m->>'total_devido')::numeric, 0);
  END LOOP;

  RETURN jsonb_build_object(
    'capital', round(capital,2),
    'rendimentos', round(rend,2),
    'levantamentos', round(lev,2),
    'saldo', round(saldo,2),
    'divida', round(divida,2),
    'bloqueado', round(LEAST(divida, saldo),2),
    'disponivel', round(GREATEST(saldo - divida, 0),2),
    'liquido', round(saldo - divida,2)
  );
END; $function$
;

CREATE OR REPLACE FUNCTION public.pg_stats_grupo(p_grupo_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  r RECORD; res jsonb; saldo_total numeric := 0; divida_total numeric := 0;
  inadimplentes int := 0; s jsonb;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM public.pg_grupos WHERE id = p_grupo_id
     AND (user_id = auth.uid() OR public.has_role(auth.uid(),'superadmin'))) THEN
    RETURN jsonb_build_object('error','forbidden');
  END IF;

  FOR r IN SELECT id FROM public.pg_membros WHERE grupo_id = p_grupo_id LOOP
    s := public.pg_saldo_membro(r.id);
    saldo_total := saldo_total + (s->>'saldo')::numeric;
    divida_total := divida_total + (s->>'divida')::numeric;
    IF (s->>'divida')::numeric > 0 THEN
      IF EXISTS (SELECT 1 FROM public.pg_emprestimos e WHERE e.membro_id = r.id
                 AND e.estado NOT IN ('pago','cancelado')
                 AND CURRENT_DATE > e.data_vencimento + COALESCE(e.dias_tolerancia,0)) THEN
        inadimplentes := inadimplentes + 1;
      END IF;
    END IF;
  END LOOP;

  SELECT jsonb_build_object(
    'saldo_total', round(saldo_total,2),
    'divida_total', round(divida_total,2),
    'clientes_inadimplentes', inadimplentes,
    'total_poupado', COALESCE((SELECT SUM(valor) FROM public.pg_movimentos WHERE grupo_id=p_grupo_id AND tipo='deposito' AND estornado=false),0),
    'total_rendimentos', COALESCE((SELECT SUM(valor) FROM public.pg_movimentos WHERE grupo_id=p_grupo_id AND tipo='rendimento' AND estornado=false),0),
    'total_levantamentos', COALESCE((SELECT SUM(valor) FROM public.pg_movimentos WHERE grupo_id=p_grupo_id AND tipo='levantamento' AND estornado=false),0),
    'receita_assistencia', COALESCE((SELECT SUM(valor) FROM public.pg_movimentos WHERE grupo_id=p_grupo_id AND tipo='assistencia' AND estornado=false),0),
    'total_emprestado', COALESCE((SELECT SUM(valor) FROM public.pg_emprestimos WHERE grupo_id=p_grupo_id AND estado <> 'cancelado'),0),
    'total_recuperado', COALESCE((SELECT SUM(valor) FROM public.pg_pagamentos WHERE grupo_id=p_grupo_id),0),
    'receita_juros', COALESCE((SELECT SUM(valor) FROM public.pg_pagamentos WHERE grupo_id=p_grupo_id AND tipo='juros'),0),
    'receita_mora', COALESCE((SELECT SUM(valor) FROM public.pg_pagamentos WHERE grupo_id=p_grupo_id AND tipo='mora'),0),
    'receita_multa', COALESCE((SELECT SUM(valor) FROM public.pg_pagamentos WHERE grupo_id=p_grupo_id AND tipo='multa'),0),
    'clientes_ativos', COALESCE((SELECT COUNT(*) FROM public.pg_membros WHERE grupo_id=p_grupo_id AND estado='ativo'),0),
    'total_membros', COALESCE((SELECT COUNT(*) FROM public.pg_membros WHERE grupo_id=p_grupo_id),0),
    'emprestimos_activos', COALESCE((SELECT COUNT(*) FROM public.pg_emprestimos WHERE grupo_id=p_grupo_id AND estado NOT IN ('pago','cancelado')),0)
  ) INTO res;
  RETURN res;
END; $function$
;

CREATE OR REPLACE FUNCTION public.promote_to_superadmin(user_email text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  target_user_id UUID;
BEGIN
  -- Buscar o user_id baseado no email
  SELECT id INTO target_user_id
  FROM auth.users
  WHERE email = user_email
  LIMIT 1;

  IF target_user_id IS NULL THEN
    RAISE EXCEPTION 'Usuário com email % não encontrado', user_email;
  END IF;

  -- Atualizar role em user_profiles
  UPDATE public.user_profiles
  SET role = 'superadmin'
  WHERE user_id = target_user_id;

  -- Atualizar role em user_roles
  UPDATE public.user_roles
  SET role = 'superadmin'
  WHERE user_id = target_user_id;

  -- Se não existir em user_roles, inserir
  IF NOT FOUND THEN
    INSERT INTO public.user_roles (user_id, role)
    VALUES (target_user_id, 'superadmin')
    ON CONFLICT (user_id, role) DO NOTHING;
  END IF;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.recalcular_capital_actual(p_user_id uuid, p_mes_ano text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_capital_inicial NUMERIC;
  v_creditos NUMERIC;
  v_reembolsos NUMERIC;
  v_juros NUMERIC;
  v_entradas NUMERIC;
  v_despesas NUMERIC;
  v_capital_actual NUMERIC;
BEGIN
  -- Obter capital inicial do mês
  SELECT capital_inicial_mes INTO v_capital_inicial
  FROM capital_mensal
  WHERE user_id = p_user_id AND mes_ano = p_mes_ano;
  
  IF v_capital_inicial IS NULL THEN
    RETURN;
  END IF;
  
  -- Calcular total de créditos concedidos no mês
  SELECT COALESCE(SUM(valor), 0) INTO v_creditos
  FROM emprestimos
  WHERE user_id = p_user_id 
    AND to_char(data_desembolso, 'YYYY-MM') = p_mes_ano;
  
  -- Calcular total de reembolsos (capital) no mês
  SELECT COALESCE(SUM(p.valor), 0) INTO v_reembolsos
  FROM pagamentos p
  JOIN emprestimos e ON e.id = p.emprestimo_id
  WHERE e.user_id = p_user_id 
    AND to_char(p.data_pagamento, 'YYYY-MM') = p_mes_ano
    AND p.tipo IN ('Parcela', 'Amortização');
  
  -- Calcular total de juros recebidos no mês
  SELECT COALESCE(SUM(p.valor), 0) INTO v_juros
  FROM pagamentos p
  JOIN emprestimos e ON e.id = p.emprestimo_id
  WHERE e.user_id = p_user_id 
    AND to_char(p.data_pagamento, 'YYYY-MM') = p_mes_ano
    AND p.tipo = 'Juros';
  
  -- Calcular total de entradas extras no mês
  SELECT COALESCE(SUM(valor), 0) INTO v_entradas
  FROM entradas_capital
  WHERE user_id = p_user_id 
    AND to_char(data, 'YYYY-MM') = p_mes_ano;
  
  -- Calcular total de despesas no mês
  SELECT COALESCE(SUM(valor), 0) INTO v_despesas
  FROM despesas
  WHERE user_id = p_user_id 
    AND to_char(data, 'YYYY-MM') = p_mes_ano;
  
  -- Aplicar fórmula
  v_capital_actual := v_capital_inicial 
    - v_creditos 
    + v_reembolsos 
    + v_juros 
    + v_entradas 
    - v_despesas;
  
  -- Atualizar registro
  UPDATE capital_mensal
  SET 
    capital_actual = v_capital_actual,
    total_creditos_concedidos = v_creditos,
    total_reembolsos_capital = v_reembolsos,
    total_juros_recebidos = v_juros,
    total_entradas_extras = v_entradas,
    total_despesas_perdas = v_despesas,
    updated_at = now()
  WHERE user_id = p_user_id AND mes_ano = p_mes_ano AND fechado = false;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.recalcular_mora_paga(p_emprestimo_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  UPDATE public.emprestimos
     SET mora_paga = COALESCE((
       SELECT SUM(valor) FROM public.pagamentos
        WHERE emprestimo_id = p_emprestimo_id AND tipo = 'Juros Mora'
     ), 0)
   WHERE id = p_emprestimo_id;
END;
