CREATE OR REPLACE FUNCTION public.validar_pagamento_manual(p_codigo text, p_pacote_id uuid, p_metodo text, p_comprovativo_url text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_user_id uuid;
  v_pacote RECORD;
  v_pagamento RECORD;
  v_data_fim timestamptz;
  v_expiracao_atual timestamptz;
  v_codigo_norm text;
BEGIN
  v_user_id := auth.uid();
  IF v_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Sessão expirada. Faça login novamente.');
  END IF;

  IF p_metodo NOT IN ('mpesa','emola') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Método de pagamento inválido.');
  END IF;

  v_codigo_norm := upper(regexp_replace(coalesce(p_codigo,''), '\s', '', 'g'));
  IF length(v_codigo_norm) < 6 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Código de confirmação inválido.');
  END IF;

  SELECT * INTO v_pacote FROM pacotes_plataforma WHERE id = p_pacote_id AND ativo = true;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Pacote indisponível.');
  END IF;

  -- Procurar pagamento
  SELECT * INTO v_pagamento
  FROM incoming_payments
  WHERE upper(regexp_replace(codigo_transacao,'\s','','g')) = v_codigo_norm
  FOR UPDATE;

  IF NOT FOUND THEN
    -- Registar tentativa falhada
    INSERT INTO subscription_requests (user_id, plano, valor_esperado, metodo_pagamento, codigo_submetido, status, motivo_rejeicao, comprovativo_imagem_url)
    VALUES (v_user_id, v_pacote.nome, v_pacote.preco, p_metodo, p_codigo, 'rejeitado', 'Código não encontrado', p_comprovativo_url);
    RETURN jsonb_build_object('success', false, 'error', 'Código não encontrado. Verifique e tente novamente, ou contacte o suporte 875611599.');
  END IF;

  IF v_pagamento.status = 'usado' THEN
    INSERT INTO subscription_requests (user_id, plano, valor_esperado, metodo_pagamento, codigo_submetido, status, motivo_rejeicao, comprovativo_imagem_url)
    VALUES (v_user_id, v_pacote.nome, v_pacote.preco, p_metodo, p_codigo, 'rejeitado', 'Código já utilizado', p_comprovativo_url);
    RETURN jsonb_build_object('success', false, 'error', 'Este código já foi utilizado. Contacte o suporte 875611599.');
  END IF;

  IF v_pagamento.status <> 'disponivel' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Pagamento indisponível. Contacte o suporte 875611599.');
  END IF;

  IF v_pagamento.metodo <> p_metodo THEN
    RETURN jsonb_build_object('success', false, 'error', 'Método de pagamento não corresponde ao código. Contacte o suporte 875611599.');
  END IF;

  IF abs(coalesce(v_pagamento.valor,0) - coalesce(v_pacote.preco,0)) > 1 THEN
    INSERT INTO subscription_requests (user_id, plano, valor_esperado, metodo_pagamento, codigo_submetido, status, motivo_rejeicao, comprovativo_imagem_url)
    VALUES (v_user_id, v_pacote.nome, v_pacote.preco, p_metodo, p_codigo, 'rejeitado',
            'Valor pago (' || v_pagamento.valor || ') não corresponde ao plano (' || v_pacote.preco || ')', p_comprovativo_url);
    RETURN jsonb_build_object('success', false, 'error',
      'O valor pago (' || v_pagamento.valor || ' MT) não corresponde ao plano escolhido (' || v_pacote.preco || ' MT). Contacte o suporte 875611599.');
  END IF;

  -- Calcular nova data fim (estende se ainda válido)
  SELECT expires_at INTO v_expiracao_atual FROM user_profiles WHERE user_id = v_user_id;
  IF v_expiracao_atual IS NOT NULL AND v_expiracao_atual > now() THEN
    v_data_fim := v_expiracao_atual + (v_pacote.duracao_dias || ' days')::interval;
  ELSE
    v_data_fim := now() + (v_pacote.duracao_dias || ' days')::interval;
  END IF;

  -- Marcar pagamento usado
  UPDATE incoming_payments SET status = 'usado', pacote_nome = v_pacote.nome WHERE id = v_pagamento.id;

  -- Criar subscription_request aprovado
  INSERT INTO subscription_requests (user_id, plano, valor_esperado, metodo_pagamento, codigo_submetido, status, comprovativo_imagem_url)
  VALUES (v_user_id, v_pacote.nome, v_pacote.preco, p_metodo, p_codigo, 'aprovado', p_comprovativo_url);

  -- Activar perfil
  UPDATE user_profiles
  SET status = 'active',
      expires_at = v_data_fim,
      usage_days = v_pacote.duracao_dias,
      updated_at = now()
  WHERE user_id = v_user_id;

  -- Histórico
  INSERT INTO historico_renovacoes (user_id, tipo, pacote_nome, dias_adicionados, data_inicio, data_fim, valor, observacoes)
  VALUES (v_user_id, 'automatica', v_pacote.nome, v_pacote.duracao_dias, now(), v_data_fim, v_pagamento.valor,
          'Activação automática via ' || upper(p_metodo) || ' - Código: ' || v_pagamento.codigo_transacao);

  -- Notificação
  INSERT INTO notificacoes (user_id, titulo, mensagem, tipo)
  VALUES (v_user_id, '✅ Plano Activado',
          'Pacote ' || v_pacote.nome || ' activado com sucesso. Acesso até ' || to_char(v_data_fim, 'DD/MM/YYYY HH24:MI'),
          'success');

