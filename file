CREATE OR REPLACE FUNCTION public.rejeitar_pagamento_superadmin(p_request_id uuid, p_motivo text DEFAULT NULL::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_request RECORD;
  v_max_outro timestamptz;
BEGIN
  IF NOT has_role(auth.uid(), 'superadmin') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Acesso negado.');
  END IF;

  SELECT * INTO v_request FROM subscription_requests WHERE id = p_request_id FOR UPDATE;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Pedido não encontrado.');
  END IF;

  UPDATE subscription_requests
  SET status = 'rejeitado', acesso_temporario = false, motivo_rejeicao = COALESCE(p_motivo, 'Rejeitado pelo superadmin')
  WHERE id = p_request_id;

  -- O código fica bloqueado (continua na BD)
  UPDATE incoming_payments SET status = 'rejeitado'
  WHERE codigo_transacao = v_request.codigo_submetido AND status = 'pendente_confirmacao';

  -- Recalcular expires_at do usuário (manter outros pacotes válidos se existirem)
  SELECT MAX(data_fim) INTO v_max_outro
  FROM subscriptions
  WHERE user_id = v_request.user_id AND status = 'activo' AND data_fim > now();

  UPDATE user_profiles
  SET expires_at = COALESCE(v_max_outro, now()),
      status = CASE WHEN v_max_outro IS NOT NULL THEN 'active' ELSE 'inactive' END,
      updated_at = now()
  WHERE user_id = v_request.user_id;

  INSERT INTO notificacoes (user_id, titulo, mensagem, tipo)
  VALUES (v_request.user_id, '❌ Pagamento rejeitado',
          'O seu pagamento foi rejeitado: ' || COALESCE(p_motivo, 'sem detalhe') || '. Contacte o suporte 875611599.',
          'urgente');

  RETURN jsonb_build_object('success', true);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.relatorio_mora_user(p_scope_user_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  rec RECORD;
  m jsonb;
  itens jsonb := '[]'::jsonb;
  total_juros numeric := 0;
  total_clientes int := 0;
  total_prest int := 0;
BEGIN
  FOR rec IN
    SELECT e.id, e.cliente_id, c.nome_completo, c.telefone
    FROM public.emprestimos e
    JOIN public.clientes c ON c.id = e.cliente_id
    WHERE (e.user_id = p_scope_user_id OR e.usuario_mae_id = p_scope_user_id)
      AND e.status = 'Ativo'
      AND COALESCE(e.valor_pago,0) < COALESCE(e.valor_total, e.valor)
  LOOP
    m := public.calcular_mora_emprestimo(rec.id);
    IF (m->>'prestacoes_vencidas')::int > 0 THEN
      total_clientes := total_clientes + 1;
      total_juros := total_juros + COALESCE((m->>'juros_acumulados')::numeric, 0);
      total_prest := total_prest + COALESCE((m->>'prestacoes_vencidas')::int, 0);
      itens := itens || jsonb_build_object(
        'emprestimo_id', rec.id,
        'cliente_id', rec.cliente_id,
        'nome_completo', rec.nome_completo,
        'telefone', rec.telefone,
        'prestacoes_vencidas', (m->>'prestacoes_vencidas')::int,
        'juros_acumulados', (m->>'juros_acumulados')::numeric,
        'saldo_devedor', (m->>'valor_original_divida')::numeric,
        'total_atualizado', (m->>'total_atualizado')::numeric
      );
    END IF;
  END LOOP;

  RETURN jsonb_build_object(
    'total_clientes_em_mora', total_clientes,
    'total_juros_acumulados', round(total_juros::numeric, 2),
    'total_prestacoes_vencidas', total_prest,
    'itens', itens
  );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.resgatar_cupao(p_codigo text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_cupao RECORD;
  v_user_id UUID;
  v_nova_expiracao TIMESTAMP WITH TIME ZONE;
  v_expiracao_atual TIMESTAMP WITH TIME ZONE;
BEGIN
  v_user_id := auth.uid();
  
  IF v_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Usuário não autenticado');
  END IF;
  
  -- Buscar cupão (lock para evitar race condition)
  SELECT * INTO v_cupao
  FROM cupoes_acesso
  WHERE codigo = upper(p_codigo)
  FOR UPDATE;
  
  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Código inválido');
  END IF;
  
  IF v_cupao.status = 'resgatado' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Este cupão já foi resgatado');
  END IF;
  
  IF v_cupao.status = 'revogado' THEN
    RETURN jsonb_build_object('success', false, 'error', 'Este cupão foi revogado');
  END IF;
  
  IF v_cupao.status = 'expirado' OR (v_cupao.validade_cupao IS NOT NULL AND v_cupao.validade_cupao < now()) THEN
    UPDATE cupoes_acesso SET status = 'expirado' WHERE id = v_cupao.id;
    RETURN jsonb_build_object('success', false, 'error', 'Este cupão expirou');
  END IF;
  
  -- Calcular nova data de expiração (estende a partir da atual se ainda válida)
  SELECT expires_at INTO v_expiracao_atual
  FROM user_profiles WHERE user_id = v_user_id;
  
  IF v_expiracao_atual IS NOT NULL AND v_expiracao_atual > now() THEN
    v_nova_expiracao := v_expiracao_atual + (v_cupao.duracao_dias || ' days')::interval;
  ELSE
    v_nova_expiracao := now() + (v_cupao.duracao_dias || ' days')::interval;
  END IF;
  
  -- Marcar cupão como resgatado
  UPDATE cupoes_acesso
  SET status = 'resgatado',
      resgatado_por = v_user_id,
      resgatado_em = now()
  WHERE id = v_cupao.id;
  
  -- Atualizar perfil do usuário
  UPDATE user_profiles
  SET status = 'active',
      expires_at = v_nova_expiracao,
      usage_days = v_cupao.duracao_dias,
      updated_at = now()
  WHERE user_id = v_user_id;
  
  -- Registar no histórico de renovações
  INSERT INTO historico_renovacoes (
    user_id, tipo, pacote_nome, dias_adicionados, 
    data_inicio, data_fim, observacoes, registrado_por
  ) VALUES (
    v_user_id, 'cupao', v_cupao.pacote_nome, v_cupao.duracao_dias,
    now(), v_nova_expiracao, 
    'Resgatado via cupão: ' || v_cupao.codigo,
    v_cupao.criado_por
  );
  
  -- Notificar usuário
  INSERT INTO notificacoes (user_id, titulo, mensagem, tipo)
  VALUES (
    v_user_id,
    '✅ Acesso Activado',
    'Cupão ' || v_cupao.codigo || ' resgatado com sucesso. Tem acesso ao ' || v_cupao.pacote_nome || ' (' || v_cupao.duracao_dias || ' dias).',
    'success'
  );
  
  RETURN jsonb_build_object(
    'success', true,
    'pacote', v_cupao.pacote_nome,
    'dias', v_cupao.duracao_dias,
    'expira_em', v_nova_expiracao
  );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.revogar_acessos_temporarios()
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
BEGIN
  -- Find payments that are still pending and past the validation deadline
  UPDATE public.pagamentos_plataforma
  SET status = 'expirado', updated_at = now()
  WHERE status = 'temporario'
    AND data_limite_validacao < now();

  -- Deactivate user accounts whose temporary access expired
  UPDATE public.user_profiles
  SET status = 'inactive', updated_at = now()
  WHERE status = 'active'
    AND user_id IN (
      SELECT DISTINCT user_id FROM public.pagamentos_plataforma
      WHERE status = 'expirado'
        AND updated_at > now() - interval '1 minute'
    );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.revogar_subscricoes_temporarias()
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  r RECORD;
BEGIN
  FOR r IN 
    SELECT sr.id, sr.user_id, sr.plano
    FROM subscription_requests sr
    WHERE sr.acesso_temporario = true
      AND sr.status = 'temporario'
      AND sr.data_limite_confirmacao < now()
  LOOP
    -- Update request status
    UPDATE subscription_requests SET status = 'expirado' WHERE id = r.id;
    
    -- Delete temporary subscription
    DELETE FROM subscriptions WHERE request_id = r.id;
    
    -- Recalculate user expiry
    UPDATE user_profiles SET 
      status = CASE 
        WHEN EXISTS (SELECT 1 FROM subscriptions WHERE user_id = r.user_id AND status = 'activo' AND data_fim > now()) 
        THEN 'active' ELSE 'inactive' 
      END,
      expires_at = COALESCE(
        (SELECT MAX(data_fim) FROM subscriptions WHERE user_id = r.user_id AND status = 'activo'),
        now()
      ),
      updated_at = now()
    WHERE user_id = r.user_id;
    
    -- Send notification
    INSERT INTO notificacoes (user_id, titulo, mensagem, tipo)
    VALUES (
      r.user_id,
      'Acesso Temporário Expirado',
      'O seu acesso temporário para o pacote ' || r.plano || ' expirou pois não foi confirmado pelo suporte em 24h. Por favor contacte o suporte: 875611599',
      'urgente'
    );
  END LOOP;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.search_clientes_paginated(p_search text DEFAULT ''::text, p_page integer DEFAULT 1, p_page_size integer DEFAULT 50)
 RETURNS jsonb
 LANGUAGE sql
 STABLE
 SET search_path TO 'public'
AS $function$
  WITH base AS (
    SELECT c.*,
      COALESCE(up_a.full_name, up_u.full_name, '') AS criado_por_nome,
      COALESCE(up_a.role::text, up_u.role::text, '') AS criado_por_role
    FROM public.clientes c
    LEFT JOIN public.user_profiles up_a ON up_a.user_id = c.agente_id
    LEFT JOIN public.user_profiles up_u ON up_u.user_id = c.user_id
    WHERE (
      p_search IS NULL OR p_search='' OR
      c.nome_completo ILIKE '%'||p_search||'%' OR
      c.telefone ILIKE '%'||p_search||'%' OR
      COALESCE(c.nuit,'') ILIKE '%'||p_search||'%'
    )
  ),
  total AS (SELECT COUNT(*) AS n FROM base),
  page AS (
    SELECT * FROM base
    ORDER BY created_at DESC
    LIMIT GREATEST(p_page_size,1)
    OFFSET GREATEST((p_page-1)*p_page_size,0)
  )
  SELECT jsonb_build_object(
    'total', (SELECT n FROM total),
    'page', p_page,
    'pageSize', p_page_size,
    'rows', COALESCE((SELECT jsonb_agg(to_jsonb(page)) FROM page),'[]'::jsonb)
  );
$function$
;

CREATE OR REPLACE FUNCTION public.search_emprestimos_paginated(p_status text DEFAULT 'all'::text, p_search text DEFAULT ''::text, p_page integer DEFAULT 1, p_page_size integer DEFAULT 50)
 RETURNS jsonb
 LANGUAGE sql
 STABLE
 SET search_path TO 'public'
AS $function$
  WITH base AS (
    SELECT e.*, c.nome_completo, c.telefone,
      COALESCE(NULLIF(e.valor_total, 0), e.valor + (e.valor * COALESCE(e.taxa_juros,0)/100 * COALESCE(e.duracao_meses,1))) AS _vt,
      COALESCE(e.valor_pago, 0) AS _vp
    FROM public.emprestimos e
    JOIN public.clientes c ON c.id = e.cliente_id
    WHERE (
      p_search IS NULL OR p_search='' OR
      c.nome_completo ILIKE '%'||p_search||'%' OR
      c.telefone ILIKE '%'||p_search||'%'
    )
  ),
  filtered AS (
    SELECT * FROM base
    WHERE CASE
      WHEN p_status='ativos'   THEN (status <> 'Pago' AND _vp < _vt
                                     AND (data_reembolso IS NULL OR data_reembolso >= CURRENT_DATE))
      WHEN p_status='vencidos' THEN (status <> 'Pago' AND _vp < _vt
                                     AND data_reembolso IS NOT NULL AND data_reembolso < CURRENT_DATE)
      WHEN p_status='pagos'    THEN (status = 'Pago' OR _vp >= _vt)
      ELSE TRUE
    END
  ),
  total AS (SELECT COUNT(*) AS n FROM filtered),
  page AS (
    SELECT * FROM filtered
    ORDER BY created_at DESC
    LIMIT GREATEST(p_page_size,1)
    OFFSET GREATEST((p_page-1)*p_page_size,0)
  )
  SELECT jsonb_build_object(
    'total', (SELECT n FROM total),
    'page', p_page,
    'pageSize', p_page_size,
    'rows', COALESCE((SELECT jsonb_agg(to_jsonb(page)) FROM page),'[]'::jsonb)
  );
$function$
;

