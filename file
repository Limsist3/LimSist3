CREATE OR REPLACE FUNCTION public.recalcular_valor_pago_emprestimo(p_emprestimo_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_total_pago numeric;
BEGIN
  IF p_emprestimo_id IS NULL THEN
    RETURN;
  END IF;

  SELECT COALESCE(
    SUM(valor) FILTER (WHERE COALESCE(tipo, '') NOT IN ('Juros Mora', 'Juros')),
    0
  )
  INTO v_total_pago
  FROM public.pagamentos
  WHERE emprestimo_id = p_emprestimo_id;

  UPDATE public.emprestimos e
  SET
    valor_pago = v_total_pago,
    status = public.classificar_status_emprestimo(v_total_pago, e.valor_total, e.data_reembolso, e.status)
  WHERE e.id = p_emprestimo_id;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.reclassificar_status_emprestimos()
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_count integer;
BEGIN
  WITH atualizados AS (
    UPDATE public.emprestimos e
    SET status = public.classificar_status_emprestimo(e.valor_pago, e.valor_total, e.data_reembolso, e.status)
    WHERE e.status IS DISTINCT FROM public.classificar_status_emprestimo(e.valor_pago, e.valor_total, e.data_reembolso, e.status)
    RETURNING 1
  )
  SELECT count(*) INTO v_count FROM atualizados;
  RETURN v_count;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.reconciliar_saldos_meia_noite()
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  conta RECORD;
BEGIN
  FOR conta IN SELECT * FROM contas_financeiras WHERE saldo_contabilistico != saldo_disponivel
  LOOP
    -- Registrar movimento de reconciliação
    INSERT INTO movimentos_conta (
      user_id, conta_financeira_id, tipo_movimento, valor,
      saldo_disponivel_antes, saldo_disponivel_depois,
      saldo_contabilistico_antes, saldo_contabilistico_depois,
      descricao
    ) VALUES (
      conta.user_id, conta.id, 'reconciliacao',
      conta.saldo_contabilistico - conta.saldo_disponivel,
      conta.saldo_disponivel, conta.saldo_contabilistico,
      conta.saldo_contabilistico, conta.saldo_contabilistico,
      'Reconciliação automática à meia-noite'
    );
    
    -- Atualizar saldo disponível para igualar contabilístico
    UPDATE contas_financeiras 
    SET saldo_disponivel = saldo_contabilistico, updated_at = now()
    WHERE id = conta.id;
  END LOOP;
END;
