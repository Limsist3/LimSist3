CREATE OR REPLACE FUNCTION public.dashboard_stats_agente(p_agente_id uuid)
 RETURNS jsonb
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  WITH c AS (SELECT id, bloqueado FROM public.clientes WHERE agente_id = p_agente_id),
  e AS (SELECT * FROM public.emprestimos WHERE cliente_id IN (SELECT id FROM c)),
  p AS (SELECT pg.* FROM public.pagamentos pg WHERE pg.emprestimo_id IN (SELECT id FROM e)),
  agg AS (
    SELECT
      COALESCE(SUM(CASE WHEN status='Ativo' THEN valor END),0) AS total_emprestado,
      COALESCE(SUM(CASE WHEN status='Ativo' THEN (valor_total-valor_pago) END),0) AS total_a_receber,
      COALESCE(SUM(CASE WHEN status='Ativo' AND (data_reembolso IS NULL OR data_reembolso >= CURRENT_DATE) THEN (valor_total-valor_pago) END),0) AS valor_em_dia,
      COALESCE(SUM(CASE WHEN status='Ativo' AND data_reembolso < CURRENT_DATE AND valor_total>valor_pago THEN (valor_total-valor_pago) END),0) AS valor_vencido,
      COALESCE(SUM(CASE WHEN status='Pago' THEN valor_total END),0) AS valor_pago_total,
      COUNT(*) FILTER (WHERE status='Ativo') AS emprestimos_ativos,
      COUNT(*) FILTER (WHERE status='Ativo' AND data_reembolso < CURRENT_DATE AND valor_total>valor_pago) AS emprestimos_vencidos,
      COUNT(*) FILTER (WHERE status='Pago') AS emprestimos_pagos
    FROM e
  )
  SELECT jsonb_build_object(
    'totalEmprestado', agg.total_emprestado,
    'totalAReceber', agg.total_a_receber,
    'totalRecebimentos', COALESCE((SELECT SUM(valor) FROM p),0),
    'emprestimosAtivos', agg.emprestimos_ativos,
    'emprestimosVencidos', agg.emprestimos_vencidos,
    'emprestimosPagos', agg.emprestimos_pagos,
    'valorEmDia', agg.valor_em_dia,
    'valorVencido', agg.valor_vencido,
    'valorPago', agg.valor_pago_total,
    'clientesAtivos', (SELECT COUNT(*) FROM c WHERE COALESCE(bloqueado,false)=false),
    'totalClientes', (SELECT COUNT(*) FROM c),
    'taxaInadimplencia', CASE WHEN agg.emprestimos_ativos>0
        THEN ROUND((agg.emprestimos_vencidos::numeric/agg.emprestimos_ativos)*100,1) ELSE 0 END
  ) FROM agg;
$function$
;

CREATE OR REPLACE FUNCTION public.dashboard_stats_super()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE result jsonb;
BEGIN
  IF NOT public.has_role(auth.uid(), 'superadmin') THEN
    RAISE EXCEPTION 'forbidden';
  END IF;

  WITH e AS (SELECT status, valor, valor_total, valor_pago, data_reembolso FROM public.emprestimos),
  agg AS (
    SELECT
      COALESCE(SUM(valor),0) AS total_emprestado,
      COALESCE(SUM(CASE WHEN status='Ativo' THEN (valor_total-valor_pago) END),0) AS total_a_receber,
      COUNT(*) FILTER (WHERE status='Ativo') AS emp_ativos,
      COUNT(*) FILTER (WHERE status='Pago')  AS emp_pagos,
      COUNT(*) FILTER (WHERE status='Ativo' AND data_reembolso < CURRENT_DATE AND valor_total>valor_pago) AS emp_vencidos
    FROM e
  ),
  pa AS (SELECT COALESCE(SUM(valor),0) AS total FROM public.pagamentos),
  ip AS (SELECT COALESCE(SUM(valor),0) AS total FROM public.incoming_payments WHERE status IN ('disponivel','usado')),
  prof AS (
    SELECT
      COUNT(*) AS total_usuarios,
      COUNT(*) FILTER (WHERE status='active') AS usuarios_ativos,
      COUNT(*) FILTER (WHERE last_seen >= now() - interval '10 minutes') AS usuarios_online,
      COUNT(*) FILTER (WHERE role='agente') AS total_agentes,
      COUNT(*) FILTER (WHERE role='secretariado') AS total_secretariado
    FROM public.user_profiles
  ),
  cl AS (SELECT COUNT(*) AS total FROM public.clientes)
  SELECT jsonb_build_object(
    'totalEmprestadoGlobal', agg.total_emprestado,
    'totalAReceberGlobal', agg.total_a_receber,
    'totalRecebidoGlobal', pa.total + ip.total,
    'emprestimosAtivosGlobal', agg.emp_ativos,
    'emprestimosPagosGlobal', agg.emp_pagos,
    'emprestimosVencidosGlobal', agg.emp_vencidos,
    'totalClientesGlobal', cl.total,
    'totalUsuarios', prof.total_usuarios,
    'usuariosAtivos', prof.usuarios_ativos,
    'usuariosInativos', prof.total_usuarios - prof.usuarios_ativos,
    'usuariosOnline', prof.usuarios_online,
    'totalAgentes', prof.total_agentes,
    'totalSecretariado', prof.total_secretariado,
    'taxaInadimplenciaGlobal',
      CASE WHEN agg.emp_ativos>0 THEN ROUND((agg.emp_vencidos::numeric/agg.emp_ativos)*100,1) ELSE 0 END
  )
  INTO result
  FROM agg, pa, ip, prof, cl;

  RETURN result;
END;
$function$
;

