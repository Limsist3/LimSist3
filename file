CREATE OR REPLACE FUNCTION public.list_emprestimos_pagamentos_paginated(p_search text DEFAULT ''::text, p_page integer DEFAULT 1, p_page_size integer DEFAULT 50)
 RETURNS jsonb
 LANGUAGE sql
 STABLE
 SET search_path TO 'public'
AS $function$
  WITH base AS (
    SELECT e.*, c.nome_completo, c.telefone, c.email, c.provincia, c.agente_id AS cliente_agente_id,
      COALESCE(up_a.full_name, up_u.full_name, '') AS criado_por_nome,
      COALESCE(up_a.role::text, up_u.role::text, '') AS criado_por_role,
      COALESCE(NULLIF(e.valor_total, 0), e.valor + (e.valor * COALESCE(e.taxa_juros,0)/100 * COALESCE(e.duracao_meses,1))) AS _vt,
      COALESCE(e.valor_pago, 0) AS _vp
    FROM public.emprestimos e
    JOIN public.clientes c ON c.id = e.cliente_id
    LEFT JOIN public.user_profiles up_a ON up_a.user_id = c.agente_id
    LEFT JOIN public.user_profiles up_u ON up_u.user_id = e.user_id
    WHERE e.status <> 'Pago'
      AND (
        p_search IS NULL OR p_search='' OR
        c.nome_completo ILIKE '%'||p_search||'%' OR
        c.telefone ILIKE '%'||p_search||'%'
      )
  ),
  filtered AS (SELECT * FROM base WHERE _vp < _vt),
  total AS (SELECT COUNT(*) AS n FROM filtered),
  page AS (
    SELECT * FROM filtered
    ORDER BY created_at DESC
    LIMIT GREATEST(p_page_size,1)
    OFFSET GREATEST((p_page-1)*p_page_size,0)
  )
  SELECT jsonb_build_object(
    'total', (SELECT n FROM total),
    'page', p_page,
    'pageSize', p_page_size,
    'rows', COALESCE((SELECT jsonb_agg(to_jsonb(page)) FROM page),'[]'::jsonb)
  );
$function$
;

