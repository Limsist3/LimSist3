CREATE OR REPLACE FUNCTION public.__dump_schema_completo()
 RETURNS text
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public', 'pg_catalog'
AS $function$
declare out text := ''; r record; begin
 out := out || E'-- =====================================================\n-- SCHEMA COMPLETO - SISTEMA LIM MICROCREDITO\n-- Gerado em: ' || now()::text || E'\n-- Executar numa base Postgres/Supabase nova, na ordem apresentada\n-- =====================================================\n\n';
 out := out || E'CREATE EXTENSION IF NOT EXISTS pgcrypto;\nCREATE EXTENSION IF NOT EXISTS pg_trgm;\nCREATE EXTENSION IF NOT EXISTS "uuid-ossp";\n\n';
 out := out || E'-- =============== 1. TIPOS ENUM ===============\n';
 for r in select t.typname, string_agg(quote_literal(e.enumlabel), ', ' order by e.enumsortorder) labels
   from pg_type t join pg_enum e on e.enumtypid=t.oid join pg_namespace n on n.oid=t.typnamespace
   where n.nspname='public' group by t.typname order by t.typname loop
   out := out || format(E'DO $$ BEGIN CREATE TYPE public.%I AS ENUM (%s); EXCEPTION WHEN duplicate_object THEN NULL; END $$;\n', r.typname, r.labels);
 end loop;
 out := out || E'\n-- =============== 2. TABELAS ===============\n';
 for r in select c.oid, c.relname from pg_class c join pg_namespace n on n.oid=c.relnamespace
   where n.nspname='public' and c.relkind='r' order by c.relname loop
   out := out || format(E'\nCREATE TABLE IF NOT EXISTS public.%I (\n', r.relname);
   out := out || (select string_agg(format('  %I %s%s%s', a.attname, format_type(a.atttypid,a.atttypmod),
        case when ad.adbin is not null then ' DEFAULT '||pg_get_expr(ad.adbin, a.attrelid) else '' end,
        case when a.attnotnull then ' NOT NULL' else '' end), E',\n' order by a.attnum)
     from pg_attribute a left join pg_attrdef ad on ad.adrelid=a.attrelid and ad.adnum=a.attnum
     where a.attrelid=r.oid and a.attnum>0 and not a.attisdropped);
   out := out || E'\n);\n';
 end loop;
 out := out || E'\n-- =============== 3. CONSTRAINTS (PK / UNIQUE / CHECK / FK) ===============\n';
 for r in select cl.relname tbl, con.conname, pg_get_constraintdef(con.oid) def, con.contype
   from pg_constraint con join pg_class cl on cl.oid=con.conrelid join pg_namespace n on n.oid=cl.relnamespace
   where n.nspname='public' order by case con.contype when 'p' then 1 when 'u' then 2 when 'c' then 3 else 4 end, cl.relname, con.conname loop
   out := out || format(E'ALTER TABLE public.%I ADD CONSTRAINT %I %s;\n', r.tbl, r.conname, r.def);
 end loop;
 out := out || E'\n-- =============== 4. INDICES ===============\n';
 for r in select indexdef from pg_indexes i where schemaname='public'
   and not exists (select 1 from pg_constraint c where c.conname=i.indexname and c.connamespace='public'::regnamespace)
   order by tablename, indexname loop
   out := out || replace(r.indexdef, 'CREATE INDEX', 'CREATE INDEX IF NOT EXISTS') || E';\n';
 end loop;
 out := out || E'\n-- =============== 5. FUNCOES ===============\n';
 for r in select pg_get_functiondef(p.oid) def, p.proname from pg_proc p join pg_namespace n on n.oid=p.pronamespace
   where n.nspname='public' and p.prokind in ('f','p')
   and p.oid not in (select objid from pg_depend where deptype='e' and classid='pg_proc'::regclass)
   order by p.proname loop
   out := out || E'\n' || r.def || E';\n';
 end loop;
 out := out || E'\n-- =============== 6. TRIGGERS ===============\n';
 for r in select pg_get_triggerdef(t.oid) def from pg_trigger t join pg_class c on c.oid=t.tgrelid
   join pg_namespace n on n.oid=c.relnamespace where n.nspname='public' and not t.tgisinternal
   order by c.relname, t.tgname loop
   out := out || r.def || E';\n';
 end loop;
 out := out || E'\n-- =============== 7. PERMISSOES (GRANTS) ===============\n';
 out := out || E'GRANT USAGE ON SCHEMA public TO anon, authenticated, service_role;\n';
 for r in select table_name tbl, grantee, string_agg(distinct privilege_type, ', ') privs
   from information_schema.role_table_grants where table_schema='public' and grantee in ('anon','authenticated','service_role')
   group by table_name, grantee order by table_name, grantee loop
   out := out || format(E'GRANT %s ON public.%I TO %I;\n', r.privs, r.tbl, r.grantee);
 end loop;
 out := out || E'\n-- =============== 8. ROW LEVEL SECURITY ===============\n';
 for r in select c.relname from pg_class c join pg_namespace n on n.oid=c.relnamespace
   where n.nspname='public' and c.relkind='r' and c.relrowsecurity order by c.relname loop
   out := out || format(E'ALTER TABLE public.%I ENABLE ROW LEVEL SECURITY;\n', r.relname);
 end loop;
 out := out || E'\n-- =============== 9. POLITICAS RLS ===============\n';
 for r in select * from pg_policies where schemaname='public' order by tablename, policyname loop
   out := out || format('CREATE POLICY %I ON public.%I AS %s FOR %s TO %s',
     r.policyname, r.tablename, r.permissive, r.cmd, array_to_string(r.roles, ', '));
   if r.qual is not null then out := out || format(' USING (%s)', r.qual); end if;
   if r.with_check is not null then out := out || format(' WITH CHECK (%s)', r.with_check); end if;
   out := out || E';\n';
 end loop;
 return out;
end $function$
;

CREATE OR REPLACE FUNCTION public.aplicar_capitalizacao_automatica(p_user_id uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_rec record;
  v_saldo numeric;
  v_juros numeric;
  v_count integer := 0;
  v_total numeric := 0;
BEGIN
  FOR v_rec IN
    SELECT e.id, e.valor_total, e.valor_pago, e.taxa_juros
    FROM public.emprestimos e
    JOIN public.configuracoes_empresa c ON c.user_id = e.user_id
    WHERE c.capitalizacao_automatica = true
      AND e.capitalizado = false
      AND COALESCE(e.status, '') <> 'pago'
      AND e.data_reembolso IS NOT NULL
      AND e.data_reembolso + (COALESCE(c.capitalizacao_dias_carencia, 3) || ' days')::interval < now()
      AND (p_user_id IS NULL OR e.user_id = p_user_id)
      AND COALESCE(e.valor_total, 0) - COALESCE(e.valor_pago, 0) > 0
  LOOP
    v_saldo := COALESCE(v_rec.valor_total, 0) - COALESCE(v_rec.valor_pago, 0);
    v_juros := round((v_saldo * COALESCE(v_rec.taxa_juros, 0) / 100)::numeric, 2);

    IF v_juros > 0 THEN
      UPDATE public.emprestimos
      SET valor_total = COALESCE(valor_total, 0) + v_juros,
          valor_capitalizado = COALESCE(valor_capitalizado, 0) + v_juros,
          capitalizado = true,
          capitalizado_em = now(),
          updated_at = now()
      WHERE id = v_rec.id;

      v_count := v_count + 1;
      v_total := v_total + v_juros;
    END IF;
  END LOOP;

  RETURN jsonb_build_object('emprestimos_capitalizados', v_count, 'juros_acrescentados', v_total);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.aprovar_pagamento_rigoroso(p_user_id uuid, p_pacote_id uuid, p_proof_id uuid, p_transaction_id text, p_amount numeric, p_operator text, p_paid_at timestamp with time zone)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_pacote RECORD;
  v_now timestamptz := now();
  v_dur int;
  v_current_expires timestamptz;
  v_new_expires timestamptz;
  v_pagamento_id uuid;
BEGIN
  SELECT id, nome, preco, duracao_dias INTO v_pacote
    FROM public.pacotes_plataforma WHERE id = p_pacote_id AND ativo = true;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'Pacote não encontrado ou inactivo';
  END IF;

  v_dur := v_pacote.duracao_dias;

  SELECT expires_at INTO v_current_expires FROM public.user_profiles WHERE user_id = p_user_id;

  IF v_current_expires IS NOT NULL AND v_current_expires > v_now THEN
    v_new_expires := v_current_expires + (v_dur || ' days')::interval;
  ELSE
    v_new_expires := v_now + (v_dur || ' days')::interval;
  END IF;

  UPDATE public.payment_proofs
    SET validation_status = 'approved',
        approved_at = v_now
  WHERE id = p_proof_id;

  INSERT INTO public.pagamentos_plataforma (
    user_id, pacote_id, valor, forma_pagamento,
    codigo_transacao, id_transacao_externo, status, score,
    data_envio, data_validacao
  ) VALUES (
    p_user_id, p_pacote_id, p_amount, p_operator,
    p_transaction_id, p_transaction_id, 'aprovado', 100,
    p_paid_at, v_now
  ) RETURNING id INTO v_pagamento_id;

  UPDATE public.user_profiles
     SET status = 'active',
         expires_at = v_new_expires,
         usage_days = GREATEST(v_dur, COALESCE(usage_days, 0))
   WHERE user_id = p_user_id;

  INSERT INTO public.historico_renovacoes (
    user_id, tipo, pacote_nome, dias_adicionados,
    data_inicio, data_fim, valor, observacoes
  ) VALUES (
    p_user_id, 'automatico', v_pacote.nome, v_dur,
    v_now, v_new_expires, p_amount,
    'Activação automática rigorosa - ID: ' || p_transaction_id
  );

  DELETE FROM public.payment_attempts WHERE user_id = p_user_id AND pacote_id = p_pacote_id;

  RETURN jsonb_build_object(
    'success', true,
    'pagamento_id', v_pagamento_id,
    'expires_at', v_new_expires,
    'pacote', v_pacote.nome
  );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.ativar_via_link(p_duracao_dias integer)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_user_id uuid;
  v_link RECORD;
  v_expiracao_atual timestamptz;
  v_nova_expiracao timestamptz;
BEGIN
  v_user_id := auth.uid();
  IF v_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Faça login primeiro para activar.');
  END IF;

  SELECT * INTO v_link FROM links_ativacao
  WHERE duracao_dias = p_duracao_dias AND ativo = true
  FOR UPDATE;

  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Link de activação inválido ou desactivado.');
  END IF;

  -- Verifica se o usuário já usou este link antes
  IF EXISTS (SELECT 1 FROM link_ativacao_uso WHERE user_id = v_user_id AND duracao_dias = p_duracao_dias) THEN
    RETURN jsonb_build_object('success', false, 'error', 'Você já activou este link anteriormente. Cada usuário pode usar cada link apenas uma vez.');
  END IF;

  SELECT expires_at INTO v_expiracao_atual FROM user_profiles WHERE user_id = v_user_id;

  IF v_expiracao_atual IS NOT NULL AND v_expiracao_atual > now() THEN
    v_nova_expiracao := v_expiracao_atual + (p_duracao_dias || ' days')::interval;
  ELSE
    v_nova_expiracao := now() + (p_duracao_dias || ' days')::interval;
  END IF;

  UPDATE user_profiles
  SET status = 'active',
      expires_at = v_nova_expiracao,
      usage_days = p_duracao_dias,
      updated_at = now()
  WHERE user_id = v_user_id;

  INSERT INTO link_ativacao_uso (user_id, duracao_dias, expira_em)
  VALUES (v_user_id, p_duracao_dias, v_nova_expiracao);

  UPDATE links_ativacao SET total_ativacoes = total_ativacoes + 1
  WHERE id = v_link.id;

  INSERT INTO historico_renovacoes (
    user_id, tipo, pacote_nome, dias_adicionados,
    data_inicio, data_fim, observacoes
  ) VALUES (
    v_user_id, 'link_ativacao', v_link.nome, p_duracao_dias,
    now(), v_nova_expiracao,
    'Activado via link público de ' || p_duracao_dias || ' dias'
  );

  INSERT INTO notificacoes (user_id, titulo, mensagem, tipo)
  VALUES (
    v_user_id,
    '✅ Acesso Activado',
    'Activou ' || v_link.nome || '. Acesso até ' || to_char(v_nova_expiracao, 'DD/MM/YYYY HH24:MI') || '.',
    'success'
  );

  RETURN jsonb_build_object(
    'success', true,
    'pacote', v_link.nome,
    'dias', p_duracao_dias,
    'expira_em', v_nova_expiracao
  );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.calcular_mora_emprestimo(p_emprestimo_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  e RECORD;
  cfg_ativa boolean;
  total_parcelas int;
  dias_entre int;
  prestacao_valor numeric;
  taxa_diaria numeric;
  valor_pago_restante numeric;
  mora_credito numeric;
  i int;
  data_venc date;
  saldo_prestacao numeric;
  dias_atraso int;
  juros_prestacao numeric;
  juros_descontado numeric;
  dias_descontados int;
  juros_total numeric := 0;
  prestacoes_vencidas int := 0;
  saldo_devedor numeric := 0;
  parcelas jsonb := '[]'::jsonb;
BEGIN
  SELECT * INTO e FROM public.emprestimos WHERE id = p_emprestimo_id;
  IF NOT FOUND THEN RETURN jsonb_build_object('error','not_found'); END IF;

  SELECT COALESCE(mora_automatica, true) INTO cfg_ativa
    FROM public.configuracoes_empresa WHERE user_id = e.user_id LIMIT 1;
  IF cfg_ativa IS NULL THEN cfg_ativa := true; END IF;

  IF COALESCE(e.modalidade_reembolso,'mensal') = 'diaria' THEN
    total_parcelas := e.duracao_meses * 30; dias_entre := 1;
  ELSIF e.modalidade_reembolso = 'semanal' THEN
    total_parcelas := e.duracao_meses * 4; dias_entre := 7;
  ELSIF e.modalidade_reembolso = 'quinzenal' THEN
    total_parcelas := e.duracao_meses * 2; dias_entre := 15;
  ELSE
    total_parcelas := e.duracao_meses; dias_entre := 30;
  END IF;

  prestacao_valor := COALESCE(e.valor_total, e.valor) / NULLIF(total_parcelas,0);
  taxa_diaria := COALESCE(e.taxa_mora, 0) / 100.0;
  valor_pago_restante := COALESCE(e.valor_pago, 0);
  mora_credito := COALESCE(e.mora_paga, 0); -- saldo de mora já paga, distribuído FIFO

  FOR i IN 1..total_parcelas LOOP
    IF COALESCE(e.modalidade_reembolso,'mensal') = 'mensal' THEN
      data_venc := (e.data_desembolso + (i || ' month')::interval)::date;
    ELSE
      data_venc := e.data_desembolso + (i * dias_entre);
    END IF;

    IF valor_pago_restante >= prestacao_valor THEN
      valor_pago_restante := valor_pago_restante - prestacao_valor;
      saldo_prestacao := 0;
    ELSE
      saldo_prestacao := prestacao_valor - valor_pago_restante;
      valor_pago_restante := 0;
    END IF;

    IF saldo_prestacao > 0 AND data_venc < CURRENT_DATE THEN
      dias_atraso := (CURRENT_DATE - data_venc);
      juros_prestacao := CASE WHEN cfg_ativa THEN saldo_prestacao * taxa_diaria * dias_atraso ELSE 0 END;

      -- desconta mora já paga (FIFO sobre as parcelas mais antigas)
      juros_descontado := 0;
      dias_descontados := 0;
      IF mora_credito > 0 AND juros_prestacao > 0 THEN
        IF mora_credito >= juros_prestacao THEN
          mora_credito := mora_credito - juros_prestacao;
          juros_descontado := juros_prestacao;
          dias_descontados := dias_atraso;
          juros_prestacao := 0;
          dias_atraso := 0;
        ELSE
          juros_descontado := mora_credito;
          IF saldo_prestacao * taxa_diaria > 0 THEN
            dias_descontados := FLOOR(mora_credito / (saldo_prestacao * taxa_diaria))::int;
          END IF;
          juros_prestacao := juros_prestacao - mora_credito;
          dias_atraso := GREATEST(0, dias_atraso - dias_descontados);
          mora_credito := 0;
        END IF;
      END IF;

      juros_total := juros_total + juros_prestacao;
      IF dias_atraso > 0 OR juros_prestacao > 0 THEN
        prestacoes_vencidas := prestacoes_vencidas + 1;
      END IF;
      saldo_devedor := saldo_devedor + saldo_prestacao;

      parcelas := parcelas || jsonb_build_object(
        'numero', i,
        'data_vencimento', data_venc,
        'valor_prestacao', round(prestacao_valor::numeric, 2),
        'saldo_pendente', round(saldo_prestacao::numeric, 2),
        'dias_atraso', dias_atraso,
        'dias_pagos_mora', dias_descontados,
        'juros_mora', round(juros_prestacao::numeric, 2),
        'juros_mora_pago', round(juros_descontado::numeric, 2)
      );
    ELSIF saldo_prestacao > 0 THEN
      saldo_devedor := saldo_devedor + saldo_prestacao;
    END IF;
  END LOOP;

  RETURN jsonb_build_object(
    'mora_ativa', cfg_ativa,
    'modalidade', COALESCE(e.modalidade_reembolso,'mensal'),
    'total_parcelas', total_parcelas,
    'prestacoes_vencidas', prestacoes_vencidas,
    'valor_original_divida', round(saldo_devedor::numeric, 2),
    'juros_acumulados', round(juros_total::numeric, 2),
    'mora_paga_acumulada', round(COALESCE(e.mora_paga,0)::numeric, 2),
    'mora_credito_excedente', round(mora_credito::numeric, 2),
    'total_atualizado', round((saldo_devedor + juros_total)::numeric, 2),
    'taxa_mora_diaria_pct', round(taxa_diaria*100, 4),
    'parcelas_em_atraso', parcelas
  );
END;
$function$
;

CREATE OR REPLACE FUNCTION public.classificar_status_emprestimo(p_valor_pago numeric, p_valor_total numeric, p_data_reembolso date, p_status_atual text DEFAULT NULL::text)
 RETURNS text
 LANGUAGE sql
 IMMUTABLE
AS $function$
  SELECT CASE
    WHEN p_status_atual = 'Cancelado' THEN 'Cancelado'
    WHEN COALESCE(p_valor_pago, 0) >= COALESCE(p_valor_total, 0) AND COALESCE(p_valor_total, 0) > 0
      THEN 'Pago'
    WHEN p_data_reembolso IS NOT NULL AND p_data_reembolso < CURRENT_DATE
      THEN 'Vencido'
    ELSE 'Ativo'
  END;
$function$
;

CREATE OR REPLACE FUNCTION public.confirmar_pagamento_superadmin(p_request_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_request RECORD;
  v_pacote RECORD;
  v_incoming RECORD;
  v_data_fim timestamptz;
  v_expira_atual timestamptz;
BEGIN
  IF NOT has_role(auth.uid(), 'superadmin') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Acesso negado.');
  END IF;

  SELECT * INTO v_request FROM subscription_requests WHERE id = p_request_id FOR UPDATE;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Pedido não encontrado.');
  END IF;

  IF v_request.status NOT IN ('temporario', 'pendente') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Pedido já processado: ' || v_request.status);
  END IF;

  SELECT * INTO v_pacote FROM pacotes_plataforma WHERE nome = v_request.plano LIMIT 1;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Pacote não encontrado.');
  END IF;

  SELECT * INTO v_incoming FROM incoming_payments WHERE codigo_transacao = v_request.codigo_submetido FOR UPDATE;

  -- Calcular data fim (estende a partir do actual, excluindo o trial 4h em curso)
  SELECT expires_at INTO v_expira_atual FROM user_profiles WHERE user_id = v_request.user_id;
  IF v_expira_atual IS NOT NULL AND v_expira_atual > now() + interval '5 hours' THEN
    -- já tinha plano longo: estende
    v_data_fim := v_expira_atual + (v_pacote.duracao_dias || ' days')::interval;
  ELSE
    v_data_fim := now() + (v_pacote.duracao_dias || ' days')::interval;
  END IF;

  UPDATE subscription_requests SET status = 'aprovado', acesso_temporario = false WHERE id = p_request_id;

  IF FOUND AND v_incoming.id IS NOT NULL THEN
    UPDATE incoming_payments SET status = 'usado', pacote_nome = v_pacote.nome WHERE id = v_incoming.id;
  END IF;

  UPDATE user_profiles
  SET status = 'active', expires_at = v_data_fim, usage_days = v_pacote.duracao_dias, updated_at = now()
  WHERE user_id = v_request.user_id;

  INSERT INTO historico_renovacoes (user_id, tipo, pacote_nome, dias_adicionados, data_inicio, data_fim, valor, observacoes, registrado_por)
  VALUES (v_request.user_id, 'automatica', v_pacote.nome, v_pacote.duracao_dias, now(), v_data_fim,
          v_request.valor_esperado,
          'Confirmado pelo superadmin via SMS - Código: ' || v_request.codigo_submetido, auth.uid());

  INSERT INTO notificacoes (user_id, titulo, mensagem, tipo)
  VALUES (v_request.user_id, '✅ Pagamento confirmado',
          'O seu pagamento foi confirmado. Pacote ' || v_pacote.nome || ' activado até ' || to_char(v_data_fim, 'DD/MM/YYYY HH24:MI') || '.',
          'success');

  RETURN jsonb_build_object('success', true, 'expira_em', v_data_fim);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.criar_pedido_subscricao(p_pacote_id uuid, p_metodo text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_uid uuid := auth.uid();
  v_pacote RECORD;
  v_id uuid;
BEGIN
  IF v_uid IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Sessão inválida.');
  END IF;

  IF p_metodo NOT IN ('mpesa', 'emola') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Método de pagamento inválido.');
  END IF;

  SELECT * INTO v_pacote FROM pacotes_plataforma WHERE id = p_pacote_id AND ativo = true;
  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Pacote não encontrado.');
  END IF;

  IF EXISTS (
    SELECT 1 FROM subscription_requests
    WHERE user_id = v_uid AND status = 'pendente' AND created_at > now() - interval '2 hours'
  ) THEN
    RETURN jsonb_build_object('success', false, 'error', 'Já tem um pedido pendente em análise.');
  END IF;

  INSERT INTO subscription_requests (user_id, plano, valor_esperado, metodo_pagamento, codigo_submetido, status)
  VALUES (v_uid, v_pacote.nome, v_pacote.preco, p_metodo, NULL, 'pendente')
  RETURNING id INTO v_id;

  RETURN jsonb_build_object('success', true, 'id', v_id, 'pacote', v_pacote.nome, 'valor', v_pacote.preco);
END;
$function$
;

CREATE OR REPLACE FUNCTION public.dashboard_monthly_super(p_months integer DEFAULT 6)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE result jsonb;
BEGIN
  IF NOT public.has_role(auth.uid(),'superadmin') THEN RAISE EXCEPTION 'forbidden'; END IF;
  WITH meses AS (
    SELECT generate_series(
      date_trunc('month', CURRENT_DATE) - ((p_months-1)||' months')::interval,
      date_trunc('month', CURRENT_DATE),
      interval '1 month'
    )::date AS m
  )
  SELECT COALESCE(jsonb_agg(jsonb_build_object(
    'mes', to_char(m,'YYYY-MM'),
    'emprestimos', COALESCE((SELECT SUM(valor) FROM public.emprestimos
      WHERE data_desembolso >= m AND data_desembolso < (m + interval '1 month')),0),
    'recebimentos', COALESCE((SELECT SUM(valor) FROM public.pagamentos
      WHERE data_pagamento >= m AND data_pagamento < (m + interval '1 month')),0)
  ) ORDER BY m), '[]'::jsonb)
  INTO result FROM meses;
  RETURN result;
END;
$function$
;

