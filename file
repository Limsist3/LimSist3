CREATE OR REPLACE FUNCTION public.gerar_codigo_cupao()
 RETURNS text
 LANGUAGE plpgsql
AS $function$
DECLARE
  chars TEXT := 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; -- sem 0,O,1,I para evitar confusão
  result TEXT := '';
  i INTEGER;
BEGIN
  FOR i IN 1..8 LOOP
