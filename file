CREATE OR REPLACE FUNCTION public.submeter_sms_pagamento(p_sms text, p_pacote_id uuid, p_metodo text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_user_id uuid := auth.uid();
  v_pacote record;
  v_codigo text;
  v_valor numeric;
  v_match text;
  v_existing record;
  v_incoming_id uuid;
  v_request_id uuid;
  v_now timestamptz := now();
  v_temp_until timestamptz := now() + interval '4 hours';
  v_temp_profile_until timestamptz;
  v_clean text;
  v_token text;
  v_sms_normalizada text;
  v_superadmin record;
BEGIN
  IF v_user_id IS NULL THEN
    RETURN jsonb_build_object('success', false, 'error', 'Sessão expirada. Faça login novamente.');
  END IF;

  IF p_metodo NOT IN ('mpesa', 'emola') THEN
    RETURN jsonb_build_object('success', false, 'error', 'Método de pagamento inválido.');
  END IF;

  IF p_sms IS NULL OR length(trim(p_sms)) < 10 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Cole o texto completo da SMS de confirmação.');
  END IF;

  SELECT * INTO v_pacote
  FROM public.pacotes_plataforma
  WHERE id = p_pacote_id AND ativo = true;

  IF NOT FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Pacote indisponível.');
  END IF;

  v_sms_normalizada := regexp_replace(lower(trim(p_sms)), '\s+', ' ', 'g');

  -- Extrair código de transacção em formatos comuns de M-Pesa/E-Mola.
  v_match := (regexp_match(
    p_sms,
    '(?:trans\.?\s*id|transaction\s*id|id\s*(?:da\s*)?transa[cç][aã]o|transa[cç][aã]o|refer[eê]ncia|ref\.?|recibo|receipt|c[oó]digo)[:\s#\-\.]*([A-Z0-9][A-Z0-9\-]{5,39})',
    'i'
  ))[1];

  IF v_match IS NULL THEN
    v_match := (regexp_match(
      upper(p_sms),
      '\b([A-Z]{1,8}[0-9][A-Z0-9]{5,31}|[0-9]{2,8}[A-Z]{2,8}[A-Z0-9]{2,24})\b'
    ))[1];
  END IF;

  IF v_match IS NULL THEN
    SELECT t INTO v_token
    FROM (
      SELECT (regexp_matches(upper(p_sms), '[A-Z0-9]{6,32}', 'g'))[1] AS t
    ) s
    WHERE t ~ '[A-Z]' AND t ~ '[0-9]'
      AND t !~ '^(MPESA|E?MOLA|EMOLA|MZN|MT|SALDO|CONTA|CLIENTE|CONFIRMADO|CONFIRMADA)$'
    ORDER BY length(t) DESC
    LIMIT 1;
    v_match := v_token;
  END IF;

  v_codigo := upper(regexp_replace(coalesce(v_match, ''), '[^A-Za-z0-9]', '', 'g'));

  -- Se a SMS não tiver um código claro, usa uma referência única da própria SMS.
  IF length(v_codigo) < 6 THEN
    v_codigo := 'SMS-' || upper(substr(md5(v_sms_normalizada), 1, 20));
  END IF;

  -- Extrair valor pago.
  v_match := (regexp_match(p_sms, '(\d[\d\s.,]*)\s*(?:MT|MZN|Meticais)', 'i'))[1];
  IF v_match IS NULL THEN
    v_match := (regexp_match(p_sms, '(?:MT|MZN|Meticais)\s*(\d[\d\s.,]*)', 'i'))[1];
  END IF;
  IF v_match IS NULL THEN
    v_match := (regexp_match(p_sms, '(?:valor|montante|recebeu|recebeste|transferiu|transferiste|enviou|enviaste)[:\s]*(\d[\d\s.,]*)', 'i'))[1];
  END IF;
  IF v_match IS NULL THEN
    v_match := (regexp_match(p_sms, '(\d{1,3}(?:[\s.]\d{3})*(?:[,.]\d{1,2})?)'))[1];
  END IF;

  BEGIN
    v_clean := regexp_replace(coalesce(v_match, ''), '\s', '', 'g');
    IF v_clean ~ ',\d{1,2}$' THEN
      v_clean := replace(replace(v_clean, '.', ''), ',', '.');
    ELSE
      v_clean := replace(v_clean, ',', '');
    END IF;
    v_valor := v_clean::numeric;
  EXCEPTION WHEN OTHERS THEN
    v_valor := NULL;
  END;

  IF v_valor IS NULL OR v_valor <= 0 THEN
    RETURN jsonb_build_object('success', false, 'error', 'Não foi possível identificar o valor pago na SMS. Cole o texto completo recebido da operadora.');
  END IF;

  SELECT * INTO v_existing
  FROM public.incoming_payments
  WHERE codigo_transacao = v_codigo;

  IF FOUND THEN
    RETURN jsonb_build_object('success', false, 'error', 'Esta SMS já foi submetida anteriormente. Cada SMS só pode ser usada uma vez. Contacte o suporte 875611599.');
  END IF;

  INSERT INTO public.incoming_payments (
    metodo, valor, codigo_transacao, mensagem_original, status, pacote_nome, valido, submetido_por
  ) VALUES (
    p_metodo, v_valor, v_codigo, p_sms, 'pendente_confirmacao', v_pacote.nome, false, v_user_id
  ) RETURNING id INTO v_incoming_id;

  INSERT INTO public.subscription_requests (
    user_id,
    plano,
    valor_esperado,
    metodo_pagamento,
    codigo_submetido,
    status,
    acesso_temporario,
    data_limite_confirmacao,
    comprovativo_mensagem,
    created_at
  ) VALUES (
    v_user_id,
    v_pacote.nome,
    v_pacote.preco,
    p_metodo,
    v_codigo,
    'temporario',
    true,
    v_temp_until,
    p_sms,
    v_now
  ) RETURNING id INTO v_request_id;

  UPDATE public.incoming_payments
  SET subscription_request_id = v_request_id
  WHERE id = v_incoming_id;

  SELECT GREATEST(coalesce(expires_at, v_now), v_temp_until)
  INTO v_temp_profile_until
  FROM public.user_profiles
  WHERE user_id = v_user_id;

  UPDATE public.user_profiles
  SET status = 'active',
      expires_at = coalesce(v_temp_profile_until, v_temp_until),
      updated_at = v_now
  WHERE user_id = v_user_id;

  FOR v_superadmin IN SELECT user_id FROM public.user_roles WHERE role = 'superadmin' LOOP
    INSERT INTO public.notificacoes (user_id, titulo, mensagem, tipo, global)
    VALUES (
      v_superadmin.user_id,
      '💰 Novo pagamento por confirmar',
      'Utilizador submeteu SMS de ' || upper(p_metodo) || ': ' || v_pacote.nome || ' - ' || v_valor || ' MT (cód. ' || v_codigo || '). Confirme ou rejeite.',
      'urgente',
      false
    );
  END LOOP;

  RETURN jsonb_build_object(
    'success', true,
    'pendente', true,
    'request_id', v_request_id,
    'pacote', v_pacote.nome,
    'valor', v_valor,
    'codigo', v_codigo,
    'acesso_temporario_ate', v_temp_until
  );
END;
$function$
;

