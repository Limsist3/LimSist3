CREATE OR REPLACE FUNCTION public.get_or_create_capital_mensal(p_user_id uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_mes_ano TEXT;
  v_capital_mensal_id UUID;
  v_capital_inicial NUMERIC;
  v_ultimo_mes RECORD;
BEGIN
  v_mes_ano := to_char(CURRENT_DATE, 'YYYY-MM');
  
  -- Verificar se já existe registro para o mês atual
  SELECT id INTO v_capital_mensal_id
  FROM capital_mensal
  WHERE user_id = p_user_id AND mes_ano = v_mes_ano;
  
  IF v_capital_mensal_id IS NULL THEN
    -- Buscar último mês fechado ou capital global
    SELECT capital_actual INTO v_capital_inicial
    FROM capital_mensal
    WHERE user_id = p_user_id AND fechado = true
    ORDER BY mes_ano DESC
    LIMIT 1;
    
    IF v_capital_inicial IS NULL THEN
      -- Buscar capital global
      SELECT valor INTO v_capital_inicial
      FROM capital_global
      WHERE user_id = p_user_id;
      
      IF v_capital_inicial IS NULL THEN
        v_capital_inicial := 0;
      END IF;
    END IF;
    
    -- Criar novo registro mensal
    INSERT INTO capital_mensal (user_id, mes_ano, capital_inicial_mes, capital_actual)
    VALUES (p_user_id, v_mes_ano, v_capital_inicial, v_capital_inicial)
    RETURNING id INTO v_capital_mensal_id;
  END IF;
  
  RETURN v_capital_mensal_id;
END;
$function$
;

