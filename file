CREATE OR REPLACE FUNCTION public.fechar_mes_capital(p_user_id uuid, p_mes_ano text)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_capital_final NUMERIC;
  v_proximo_mes TEXT;
BEGIN
  -- Recalcular antes de fechar
  PERFORM recalcular_capital_actual(p_user_id, p_mes_ano);
  
  -- Obter capital atual
  SELECT capital_actual INTO v_capital_final
  FROM capital_mensal
  WHERE user_id = p_user_id AND mes_ano = p_mes_ano;
  
  -- Fechar o mês
  UPDATE capital_mensal
  SET 
    fechado = true,
    data_fecho = now()
  WHERE user_id = p_user_id AND mes_ano = p_mes_ano;
  
  -- Calcular próximo mês
  v_proximo_mes := to_char(
    (to_date(p_mes_ano || '-01', 'YYYY-MM-DD') + INTERVAL '1 month'),
    'YYYY-MM'
  );
  
  -- Criar registro do próximo mês
  INSERT INTO capital_mensal (user_id, mes_ano, capital_inicial_mes, capital_actual)
  VALUES (p_user_id, v_proximo_mes, v_capital_final, v_capital_final)
  ON CONFLICT (user_id, mes_ano) DO NOTHING;
END;
$function$
;

