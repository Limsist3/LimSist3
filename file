CREATE OR REPLACE FUNCTION public.handle_new_user()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_superadmin_id uuid;
  v_is_first boolean;
BEGIN
  SELECT NOT EXISTS (SELECT 1 FROM public.user_profiles) INTO v_is_first;

  IF v_is_first THEN
    INSERT INTO public.user_profiles (user_id, full_name, email, role, status, usage_days, expires_at)
    VALUES (
      NEW.id,
      COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.email),
      NEW.email,
      'superadmin',
      'active',
      18250,
      now() + interval '50 years'
    );

    INSERT INTO public.user_roles (user_id, role)
    VALUES (NEW.id, 'superadmin')
    ON CONFLICT (user_id, role) DO NOTHING;

    RETURN NEW;
  END IF;

  INSERT INTO public.user_profiles (user_id, full_name, email, role, status, usage_days, expires_at)
  VALUES (
    NEW.id,
    COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.email),
    NEW.email,
    'user',
    'active',
    1,
    now() + interval '24 hours'
  );

  INSERT INTO public.user_roles (user_id, role)
  VALUES (NEW.id, 'user')
  ON CONFLICT (user_id, role) DO NOTHING;

  SELECT user_id INTO v_superadmin_id FROM public.user_roles WHERE role = 'superadmin' LIMIT 1;

  IF v_superadmin_id IS NOT NULL THEN
    INSERT INTO public.notificacoes (user_id, titulo, mensagem, tipo)
    VALUES (
      v_superadmin_id,
      '🆕 Novo Usuário Cadastrado',
      'Novo registo na plataforma (trial de 24h): ' || COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.email) || ' (' || COALESCE(NEW.email, '') || ')',
      'info'
    );
  END IF;

  RETURN NEW;
END;
$function$
;

CREATE OR REPLACE FUNCTION public.has_role(_user_id uuid, _role app_role)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
  SELECT EXISTS (
    SELECT 1
    FROM public.user_roles
    WHERE user_id = _user_id AND role = _role
  )
